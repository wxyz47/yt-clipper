# Copy to .env (or export in your shell / systemd unit) and fill in the
# token you got from @BotFather on Telegram.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: path to the transcription venv's Python
# (default: ./transcribe-venv/bin/python next to bot.py)
# TRANSCRIBE_PYTHON=/path/to/transcribe-venv/bin/python

# Optional: force a transcription language (e.g. id, en).
# Unset = Whisper auto-detects.
# TRANSCRIBE_LANGUAGE=id
